// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdBy String
  createdAt DateTime @default(now())

  seats      Seat[]
  categories SeatCategory[]
  events     Event[]
}

model SeatCategory {
  id       String  @id @default(uuid())
  venueId  String
  name     String
  colorTag String?
  showSeats ShowSeat[]
  venue Venue  @relation(fields: [venueId], references: [id])
  seats Seat[]
  waitlist Waitlist[]
}

model Seat {
  id         String @id @default(uuid())
  venueId    String
  categoryId String
  row        String
  number     Int
  label      String
  
  showSeats ShowSeat[]
  venue     Venue        @relation(fields: [venueId], references: [id])
  category  SeatCategory @relation(fields: [categoryId], references: [id])

  @@unique([venueId, row, number])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  organiserId String
  venueId     String

  venue Venue  @relation(fields: [venueId], references: [id])
  shows Show[]
}

model Show {
  id        String    @id @default(uuid())
  eventId   String
  dateTime  DateTime
  status    ShowStatus @default(SCHEDULED)

  event     Event      @relation(fields: [eventId], references: [id])
  showSeats ShowSeat[]
  bookings  Booking[]
  waitlist  Waitlist[]
}

enum ShowStatus {
  SCHEDULED
  CLOSED
}

model ShowSeat {
  id             String     @id @default(uuid())
  showId         String
  seatId         String
  categoryId     String
  price          Float
  status         SeatStatus @default(AVAILABLE)
  heldBy         String?
  holdExpiresAt  DateTime?
  bookingId      String?

  show     Show         @relation(fields: [showId], references: [id])
  seat     Seat         @relation(fields: [seatId], references: [id])
  category SeatCategory @relation(fields: [categoryId], references: [id])
  booking  Booking?     @relation(fields: [bookingId], references: [id])

  @@unique([showId, seatId])
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  showId        String
  referenceCode String        @unique
  totalAmount   Float
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())

  show  Show       @relation(fields: [showId], references: [id])
  seats ShowSeat[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Waitlist {
  id         String         @id @default(uuid())
  userId     String
  showId     String
  categoryId String
  status     WaitlistStatus @default(WAITING)
  offeredSeatId String?
  offerExpiresAt DateTime?
  createdAt  DateTime       @default(now())

  show     Show         @relation(fields: [showId], references: [id])
  category SeatCategory @relation(fields: [categoryId], references: [id])
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  CONVERTED
}

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}